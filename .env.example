# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Calorie API (só no servidor)
CALORIE_API_KEY=

# Oura OAuth2 (developer.ouraring.com > Applications)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Ex.: https://dieta-macros.vercel.app/api/oura/callback
OURA_REDIRECT_URI=

# Protege a rota de sincronização agendada (qualquer texto longo e aleatório)
CRON_SECRET=
