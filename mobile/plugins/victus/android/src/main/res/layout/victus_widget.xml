<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/victus_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="14dp" android:background="@drawable/victus_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:id="@+id/victus_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VICTUS" android:textSize="11sp" android:textColor="#006162" android:textStyle="bold"/>
      <TextView android:id="@+id/victus_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:maxLines="2" android:textColor="#006162" android:textStyle="bold"/>
      <TextView android:id="@+id/victus_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#006162"/>
    </LinearLayout>
    <ImageView android:id="@+id/victus_face" android:layout_width="68dp" android:layout_height="68dp" android:importantForAccessibility="no"/>
  </LinearLayout>
  <ProgressBar android:id="@+id/victus_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:progressTint="#006162" android:progressBackgroundTint="#B6D9CF" android:max="100"/>
  <LinearLayout android:id="@+id/victus_actions" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/victus_cup0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/victus_button" android:gravity="center" android:maxLines="2" android:textColor="#006162" android:textSize="11sp" android:textStyle="bold"/>
    <TextView android:id="@+id/victus_cup1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="5dp" android:background="@drawable/victus_button" android:gravity="center" android:maxLines="2" android:textColor="#006162" android:textSize="11sp" android:textStyle="bold"/>
    <TextView android:id="@+id/victus_more" android:layout_width="44dp" android:layout_height="match_parent" android:gravity="center" android:textColor="#006162" android:textSize="11sp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/victus_status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#006162" android:maxLines="2"/>
    <TextView android:id="@+id/victus_undo" android:layout_width="56dp" android:layout_height="32dp" android:gravity="center" android:textSize="10sp" android:textColor="#006162"/>
  </LinearLayout>
</LinearLayout>
