{
  "appId": "com.zamoriane.takingcare",
  "appName": "Taking care",
  "webDir": "www",
  "server": {
    "url": "https://takingcare.pt",
    "cleartext": false,
    "errorPath": "offline.html",
    "allowNavigation": [
      "takingcare.pt",
      "www.takingcare.pt",
      "dieta-macros.vercel.app"
    ]
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#f5f7fa",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "backgroundColor": "#f5f7fa"
  },
  "plugins": {
    "SocialLogin": {
      "providers": {
        "google": true,
        "apple": true,
        "facebook": false,
        "twitter": false
      }
    }
  }
}
